APP_ENV=local
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=affiliate_system
DB_USER=root
DB_PASS=

# Opcional. Vazio usa a instalação do MySQL/MariaDB detectada a partir do PHP/XAMPP.
MYSQL_BIN_DIR=

# Mercado Livre — mantenha desativado até confirmar que a aplicação criada
# possui acesso oficial aos recursos necessários para o programa de afiliados.
ML_OAUTH_ENABLED=false
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost/whatsappAF/admin/mercado-livre-callback.php
